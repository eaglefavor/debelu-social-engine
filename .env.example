# Copy this file to .env. Never commit .env or put credentials in frontend code.
APP_PASSWORD="replace-this-with-a-unique-password-at-least-12-characters"
APP_SECRET="replace-this-with-a-random-secret-of-at-least-32-characters"

# Local non-Docker run uses SQLite. Docker Compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL="sqlite:///./data/debelu.db"
# Generate 64 hexadecimal characters, for example: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD="replace-with-a-random-64-character-hex-value"
APP_TIMEZONE="Africa/Lagos"
SESSION_HOURS="12"

# Local use may leave APP_PUBLIC_URL blank. Social media providers must be able to reach this HTTPS origin.
# Configure the exact public origin registered as each provider's OAuth redirect base.
APP_PUBLIC_URL=""

# Use COOKIE_SECURE=false only for local HTTP development.
# Set COOKIE_SECURE=true behind HTTPS in any public deployment.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# Permit rendering inside a hosted preview iframe (https://*.e2b.app, https://arena.ai).
# Without this the app sends X-Frame-Options: DENY and frame-ancestors 'none', so a
# preview iframe stays blank. Requires COOKIE_SECURE=true and is never for production.
ALLOW_PREVIEW_EMBED="false"

# Separate AES-256-GCM key for encrypting per-account OAuth tokens at rest.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Back up this key securely: losing it requires users to reconnect every social account.
SOCIAL_TOKEN_ENCRYPTION_KEY=""

# Publishing is fail-closed until explicit configuration and app-review requirements are satisfied.
SOCIAL_PUBLISHING_ENABLED="false"
# Set true only after TikTok has audited/approved the app for the requested public-publishing use case.
TIKTOK_DIRECT_POST_AUDITED="false"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_API_VERSION="v26.0"
THREADS_APP_ID=""
THREADS_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Media limits and durable media directory. Install ffprobe (Docker image includes it) to verify video duration.
MEDIA_DIR="data/media"
MAX_IMAGE_BYTES="20971520"
MAX_VIDEO_BYTES="262144000"

# Worker runs as a separate Compose service or `python -m backend.worker`.
WORKER_POLL_SECONDS="5"
WORKER_LEASE_SECONDS="600"
WORKER_MAX_ATTEMPTS="5"
SOCIAL_HTTP_TIMEOUT_SECONDS="30"

# AI is separate from social credentials. Leave blank for manual content entry.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Optional Google Drive side-channel -------------------------------------
# Drive is NOT this app's backend and cannot be: it runs no code, has no
# transactions, and cannot serve the signed media URLs Meta and TikTok fetch.
# What it is used for is backups, importing content ideas, bulk media intake,
# exporting reports, and a status manifest. See "Google Drive side-channel" in
# the README. Disabled by default; nothing contacts Google unless this is true.
GDRIVE_ENABLED="false"

# Path to a service-account key file, or the JSON document itself.
# The service account has its own empty Drive: create a folder in YOUR Drive and
# share it with the service account's client_email, then set GDRIVE_ROOT_FOLDER_ID
# to that folder's id. Otherwise the app creates its own folder that only the
# service account can see - share it with yourself via GDRIVE_SHARE_WITH.
GDRIVE_SERVICE_ACCOUNT_JSON=""
# Optional. Existing folder id to use as the root. Blank = create/locate by name.
GDRIVE_ROOT_FOLDER_ID=""
GDRIVE_ROOT_FOLDER_NAME="Debelu Social Engine"
# Optional email to grant write access to the folders this app creates.
GDRIVE_SHARE_WITH=""

# How many database and media backups to keep in Drive. Older ones are pruned.
GDRIVE_BACKUP_RETENTION="14"
# Full Drive scope by default. A service account can only reach what is shared
# with it or what it created, which is the real access boundary here.
GDRIVE_SCOPES="https://www.googleapis.com/auth/drive"
GDRIVE_HTTP_TIMEOUT_SECONDS="120"
